# ============================================================
# pastell-mock / .env.example
# ============================================================
# Copie ce fichier en .env (NE PAS COMMITER le .env) puis exporte
# les variables avant de demarrer le mock :
#
#   cp .env.example .env
#   set -a && source .env && set +a
#   mvn -pl pastell-mock spring-boot:run
#
# Alternative one-liner (sans fichier .env) :
#
#   PASTELL_MOCK_USERNAME=sejour PASTELL_MOCK_PASSWORD=sejour-mock-pwd \
#     mvn -pl pastell-mock spring-boot:run
#
# Ces credentials seront ensuite reutilises cote sejour-backend
# (Lot 3) pour s'authentifier aupres du mock.
# ============================================================

# Login de l'utilisateur technique du mock
PASTELL_MOCK_USERNAME=sejour

# Mot de passe associe (en clair en memoire dans le mock --
# c'est OK parce que c'est un mock dev/CI, jamais en production)
PASTELL_MOCK_PASSWORD=sejour-mock-pwd
