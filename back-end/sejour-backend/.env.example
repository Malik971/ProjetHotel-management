# ============================================================
# sejour-backend / .env.example
# ============================================================
# Copier ce fichier en .env localement (NE PAS COMMITER LE .env)
# et y mettre tes vraies valeurs pour le developpement local.
#
#   cp .env.example .env
#
# Le .env est lu automatiquement par IntelliJ (run config "EnvFile" plugin)
# ou peut etre source-e en bash :
#
#   set -a && source .env && set +a
#   mvn -pl sejour-backend spring-boot:run
#
# En production (Render), ces variables sont injectees via le dashboard
# Render et le .env n'est pas utilise.
# ============================================================


# ============================================================
# Profile actif
# ============================================================
# - dev   : developpement local (defaut, lit application.properties)
# - prod  : production Render (lit aussi application-prod.properties)
# - test  : tests automatises (lit application-test.properties)
SPRING_PROFILES_ACTIVE=dev


# ============================================================
# Base de donnees PostgreSQL locale
# ============================================================
# La base hotel_db doit exister avant le premier demarrage :
#   psql -U postgres -h localhost
#   CREATE DATABASE hotel_db;
#
# Flyway prendra le relais et creera toutes les tables a partir
# des migrations V1..V4 dans src/main/resources/db/migration/
# ============================================================
DB_URL=jdbc:postgresql://localhost:5432/hotel_db
DB_USERNAME=postgres
DB_PASSWORD=postgres


# ============================================================
# Mail (Gmail SMTP)
# ============================================================
# Le mot de passe est un "Mot de passe d'application" Google,
# pas le mdp de session Gmail. A generer ici si pas deja fait :
#   https://myaccount.google.com/apppasswords
# ============================================================
MAIL_USERNAME=malik97un@gmail.com
MAIL_PASSWORD=mets-ici-ton-app-password-google


# ============================================================
# Integration Pastell (Lot 1 a 5)
# ============================================================
# Doivent matcher EXACTEMENT les valeurs PASTELL_MOCK_USERNAME
# et PASTELL_MOCK_PASSWORD du module pastell-mock, sinon les
# appels HTTP renverront 401 Unauthorized.
# ============================================================
PASTELL_USERNAME=sejour
PASTELL_PASSWORD=sejour-mock-pwd


# ============================================================
# JWT (si tu en ajoutes un secret au Sprint 1)
# ============================================================
# Pour l'instant non utilise, mais en place pour le jour ou
# tu actives l'authentification JWT (cf. roadmap audit).
# Quand tu en auras besoin :
#   - generer une cle aleatoire de 256+ bits
#   - openssl rand -base64 64
# JWT_SECRET=
# JWT_EXPIRATION_MS=86400000
